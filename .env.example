PORT=3000
DATABASE_URL=./data/revbudget.db
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32_min_32_chars
API_TOKEN=generate_with_openssl_rand_hex_32_min_32_chars
# Set to true only when behind Cloudflare. Otherwise the rate limiter falls back
# to the socket address so x-forwarded-for / x-real-ip cannot be spoofed.
TRUST_PROXY=false
DASHBOARD_ORIGIN=http://localhost:5173
APP_TIMEZONE=Europe/Madrid
VITE_API_URL=http://localhost:3000
VITE_API_TOKEN=must_match_API_TOKEN_above
NGROK_URL=https://your-ngrok-url.ngrok-free.app
