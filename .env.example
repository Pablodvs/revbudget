PORT=3000
# When wiping the database by hand, delete revbudget.db* as a unit (the -wal and
# -shm sidecars too); a fresh DB file triggers the one-time seed on next boot.
DATABASE_URL=./data/revbudget.db
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32_min_32_chars
# Set to true when behind Cloudflare (Tunnel or proxy). Otherwise the rate limiter
# falls back to the socket address so x-forwarded-for / x-real-ip cannot be spoofed.
TRUST_PROXY=false
# Public origin the dashboard is served from. For docker + Cloudflare Tunnel this
# is your tunnel hostname; for native dev keep http://localhost:5173.
# REQUIRED in production (this or BETTER_AUTH_URL) — there is no localhost
# default there, so a misconfigured deploy fails fast instead of trusting
# http://localhost:5173 as an origin.
DASHBOARD_ORIGIN=http://localhost:5173
# Comma-separated extra origins to trust for CORS + better-auth (e.g. LAN IPs
# when accessing the dev server from another device). Leave blank in prod.
TRUSTED_ORIGINS=
APP_TIMEZONE=Europe/Madrid
# Include raw notification text (financial PII) in ollama-normalizer logs.
# Off by default; enable temporarily when debugging parse failures.
LOG_NOTIFICATION_TEXT=false

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# 32+ char random secret — generate with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32_min_32_chars
# Public URL where /api/auth/* is reachable. Defaults to DASHBOARD_ORIGIN if unset.
# In production behind Cloudflare Tunnel, use the public https:// hostname even
# though Hono itself sees HTTP — better-auth needs https:// to set Secure cookies.
BETTER_AUTH_URL=http://localhost:5173
# Optional first-run admin bootstrap. If both are set AND no users exist yet,
# the server creates an admin on boot. Remove from your env after first deploy.
# Prefer the CLI on subsequent runs: `bun run create-admin -- --email x --password y`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Vite dev value, only used at dashboard build time. Leave blank to use relative
# URLs through the Vite proxy (recommended) — auth uses cookies, not env tokens.
VITE_API_URL=

# ─── Docker-only ──────────────────────────────────────────────────────────────
# Activate the cloudflared sidecar. Locally you'd pass --profile tunnel to the
# compose CLI; in Coolify (which doesn't take CLI flags) set this env var
# instead so the deploy starts cloudflared.
COMPOSE_PROFILES=tunnel
# Cloudflare Tunnel token. Create at https://one.dash.cloudflare.com/ → Networks
# → Tunnels. The tunnel's public hostname must point at http://app:3000.
TUNNEL_TOKEN=
# Override only if your Ollama instance isn't on the docker host's :11434.
OLLAMA_URL=http://host.docker.internal:11434
