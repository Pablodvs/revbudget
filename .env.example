# RevBudget configuration. Copy to .env (Bun loads it automatically) and fill
# in the two secrets below; everything else has working local defaults.
# Validated at boot: a bad value stops the server with a message naming it.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# When wiping the database by hand, delete revbudget.db* as a unit (the -wal and
# -shm sidecars too). The Docker image migrates and seeds a fresh DB file on boot;
# natively, run `bun run db:migrate` (and a seed) first.
DATABASE_URL=./data/revbudget.db
# Month boundaries for budgets and stats.
APP_TIMEZONE=Europe/Madrid
# Set by `bun run start` and the Docker image (production); leave it unset here.
# NODE_ENV=development

# ─── Secrets (required) ───────────────────────────────────────────────────────
# At least 32 chars each; generate each with: openssl rand -hex 32
# WEBHOOK_SECRET is what the Android companion app sends as X-Webhook-Secret.
WEBHOOK_SECRET=
# Signs sessions. Rotating it signs every user out.
BETTER_AUTH_SECRET=

# ─── Origins & auth ───────────────────────────────────────────────────────────
# Public origin the dashboard is served from. Native dev: http://localhost:5173.
# Local Docker: http://localhost:3000. Production: your https:// tunnel hostname.
# REQUIRED in production (this or BETTER_AUTH_URL) — there is no localhost
# default there, so a misconfigured deploy fails fast instead of trusting
# http://localhost:5173 as an origin.
DASHBOARD_ORIGIN=http://localhost:5173
# Public URL where /api/auth/* is reachable. Defaults to DASHBOARD_ORIGIN if unset.
# In production behind Cloudflare Tunnel, use the public https:// hostname even
# though Hono itself sees HTTP.
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated extra origins to trust for CORS + better-auth (e.g. LAN IPs
# when accessing the dev server from another device). Leave blank in prod.
TRUSTED_ORIGINS=
# Set to true when behind Cloudflare (Tunnel or proxy): client IPs are then read
# from cf-connecting-ip. Otherwise the rate limiters use the socket address, so
# forwarded-for headers cannot be spoofed. docker-compose.yml sets it to true.
TRUST_PROXY=false
# Optional first-run admin: if both are set AND no users exist yet, the server
# creates this admin on boot. Remove them after the first start. Prefer the CLI,
# which prompts for the password: bun run create-admin -- --email you@example.com
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# ─── Telegram (optional) ──────────────────────────────────────────────────────
# Leave both blank to run without the bot: notifications are still stored and
# wait in the dashboard. Token from @BotFather; the chat id must be your PRIVATE
# chat with the bot (never a group — every member could classify transactions).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Ollama fallback parser (optional) ────────────────────────────────────────
# Used only when the deterministic parser can't read a notification. If no
# Ollama is reachable, such notifications are simply recorded as parse failures.
# Blank OLLAMA_URL means http://localhost:11434 natively, and docker-compose.yml
# turns blank into http://host.docker.internal:11434. Never expose Ollama
# publicly — see docs/deploy.md.
OLLAMA_ENABLED=true
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=30000
# Include raw notification text (financial PII) in ollama-normalizer logs.
# Off by default; enable temporarily when debugging parse failures.
LOG_NOTIFICATION_TEXT=false

# ─── Public demo (optional) ───────────────────────────────────────────────────
# true only on a separate public demo instance (see docs/deploy.md): seeds fake
# data, shows a demo login, locks account changes, resets nightly at midnight.
# Refuses to start if Telegram is configured, and turns Ollama off.
DEMO_MODE=false

# ─── Dashboard build ──────────────────────────────────────────────────────────
# Inlined by Vite at build time. Leave blank for same-origin requests (dev goes
# through the Vite proxy); auth uses cookies, never tokens in the bundle.
VITE_API_URL=

# ─── Docker Compose only ──────────────────────────────────────────────────────
# Blank = no Cloudflare Tunnel (local Docker). Set to "tunnel" to also start the
# cloudflared sidecar — Coolify can't take CLI flags, so this is how it's enabled.
COMPOSE_PROFILES=
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). The tunnel's public
# hostname must point at http://app:3000. Passed to cloudflared via env, not argv.
TUNNEL_TOKEN=
# CPU cap for the app container; blank/0 = no limit. Set 1 on the public demo.
APP_CPUS=

# ─── QA (testing only) ────────────────────────────────────────────────────────
# For `bun run qa:auth`, the end-to-end auth check against a deployment. Prefer
# passing these inline (QA_ADMIN_PASSWORD=… bun run qa:auth): Docker Compose hands
# every .env entry to the app container, and it has no use for an admin password.
# QA_BASE_URL=
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=
# Skip the last check, which locks sign-in for ~60s:
# QA_SKIP_RATELIMIT=1
